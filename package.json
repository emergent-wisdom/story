{
  "name": "story-landscape",
  "version": "0.6.5",
  "private": true,
  "description": "A 3D landscape of a story as an agent builds it with the Meaning Model: every function over time, the understanding above, the construction replayed.",
  "scripts": {
    "serve": "node serve.mjs",
    "extract": "node extract.mjs",
    "view": "node serve.mjs",
    "test:viewer": "node --test test/*.test.mjs",
    "view:writer": "node open-model.mjs"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@emergent-wisdom/meaning-model-mcp": "https://github.com/emergent-wisdom/meaning-model/releases/download/v0.6.5/emergent-wisdom-meaning-model-mcp-0.6.5.tgz",
    "meaning-model-viewer": "github:emergent-wisdom/meaning-model-viewer#v0.6.0"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "@emergent-wisdom/meaning-model-mcp": "$@emergent-wisdom/meaning-model-mcp"
  }
}
