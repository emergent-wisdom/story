{
  "name": "life_understanding_record",
  "description": "Record one or more Understanding Nodes held by a named holder (the modeler, a writer, a character in story time), each linked to what it concerns: model records by kind:id (event, cut, process, claim, concept, referent and the other record kinds, optionally with a JSON Pointer path) or graph nodes. Kinds: question, hypothesis, prediction, interpretation, reason, criticism, revision, decision, idea, reference, voice, plan, observation, estimate, report. A report records what a source documents, with the source (citation, and url, published and reportsOn where known), so a documented fact stays distinct from what you believe or invent. Notes are placed under the holder's understanding root with the graph-revision clock (or world time for story_time) and stamped with the model revision they were written against. Keep one holder id for yourself for the whole session, and a new one only for a different mind (a continuing agent, a character); say a role such as writer or self-review in the note, not in the holder. A note must be about something. The model and its Understanding Graph are your understanding: what is not recorded cannot be picked up by a later agent, and a thought not linked to what it concerns is lost. Give every Event that carries a Cut a description of what happens in it, and describe most other Events. Record your choices, ideas, predictions, questions, voice and phrasing decisions and their reasons with life_understanding_record, linked to the records and nodes they concern. Record every outside review, from another model, a blind reader, an estimator or a person, with life_review_record under its actual reviewer, and link later changes that answer it with answers. Before you report to the user, put every reason you give there into the graph: a later agent reads the graph, not your reply. To continue existing work, read life_construction_replay from the start at outline level, then life_model_outline, and open detail where you need it. Add-only: graphHash may be any earlier revision of the graph; the record goes to its newest head, and advancedFrom says so.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "graphHash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "requestId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "accessScopes": {
        "minItems": 1,
        "maxItems": 64,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "exactRevision": {
        "default": false,
        "description": "Write against graphHash exactly, creating a branch if it is not the newest revision. By default an add-only record goes to the newest head.",
        "type": "boolean"
      },
      "holder": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "recordedBy": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "clock": {
        "default": "authoring_step",
        "type": "string",
        "enum": [
          "authoring_step",
          "story_time"
        ]
      },
      "rootLabel": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "notes": {
        "minItems": 1,
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "nodeId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "kind": {
              "type": "string",
              "enum": [
                "question",
                "hypothesis",
                "prediction",
                "interpretation",
                "reason",
                "criticism",
                "revision",
                "decision",
                "idea",
                "reference",
                "voice",
                "plan",
                "observation",
                "estimate",
                "report"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64000
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "about": {
              "default": [],
              "maxItems": 32,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "record": {
                        "type": "string",
                        "pattern": "^(model|process|claim|law|dependency|decomposition|concept|abstract_relation|abstract_cut|referent|encapsulation_cut|event|event_relation|binding|physical_cut|realization|cut):.+$"
                      },
                      "path": {
                        "type": "string",
                        "maxLength": 1024,
                        "pattern": "^\\/"
                      },
                      "modelHash": {
                        "description": "A record of another stored model (an author's life, a concept definition, another world); omit for the graph's own model.",
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "record"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "nodeId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      }
                    },
                    "required": [
                      "nodeId"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "links": {
              "default": [],
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "relation": {
                    "type": "string",
                    "enum": [
                      "about",
                      "supports",
                      "contradicts",
                      "refines",
                      "answers",
                      "learned_from",
                      "supersedes",
                      "shaped_by"
                    ]
                  },
                  "targetNodeId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "relation",
                  "targetNodeId"
                ],
                "additionalProperties": false
              }
            },
            "valueTime": {
              "type": "number"
            },
            "source": {
              "description": "For a report: the source it rests on. A report records what a source documents, not what you suppose.",
              "type": "object",
              "properties": {
                "citation": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 1000,
                  "description": "Who published what: author or organization, title, outlet."
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000,
                  "format": "uri"
                },
                "published": {
                  "description": "When the source was published, as a date.",
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 40
                },
                "reportsOn": {
                  "description": "The date or period the reported fact holds for.",
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 80
                }
              },
              "required": [
                "citation"
              ],
              "additionalProperties": false
            },
            "data": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "nodeId",
            "kind",
            "text"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "graphHash",
      "requestId",
      "accessScopes",
      "holder",
      "notes"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "$defs": {
      "__schema0": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        ]
      }
    }
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
