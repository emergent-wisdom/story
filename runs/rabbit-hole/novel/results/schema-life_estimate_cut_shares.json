{
  "name": "life_estimate_cut_shares",
  "description": "Propose normalized Cut weights for one comparison question across several described situations. An external estimator is configured (typesafe:jev-latest); the supplied text is sent to that service and scored there. Each proposal is a choice distribution over your answer keys plus an automatic remainder, returned as a ready-to-place normalized Cut with estimator provenance. Proposals are AI inference, not canon: review them and treat a large remainder as a missing category. Targets may be free-text situations or event IDs in a bound model (modelHash), whose boundary and description supply the situation text; an event target's conditionedOn {cutId, answerKey} makes its Cut divide only that answer's part of a stored Cut. With apply and requestId the tool builds the Cuts under their parent events and registers one complete immutable model revision itself, with estimator provenance; add rebind to move a model-bound story graph to that revision in the same call. You may also pass your own distributions to be placed without an estimator. Without apply nothing is written.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "unit": {
        "default": "share of one budget",
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "answers": {
        "minItems": 1,
        "maxItems": 60,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "meaning": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "required": [
            "key",
            "meaning"
          ],
          "additionalProperties": false
        }
      },
      "remainderMeaning": {
        "default": "Something else, or no single named answer dominates.",
        "type": "string",
        "minLength": 1,
        "maxLength": 16000
      },
      "subject": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          {
            "type": "null"
          }
        ]
      },
      "situations": {
        "default": [],
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "parentEventId": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16000
            }
          },
          "required": [
            "id",
            "text"
          ],
          "additionalProperties": false
        }
      },
      "modelHash": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          {
            "type": "null"
          }
        ]
      },
      "events": {
        "default": [],
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "eventId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "cutId": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                {
                  "type": "null"
                }
              ]
            },
            "situationText": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16000
                },
                {
                  "type": "null"
                }
              ]
            },
            "conditionedOn": {
              "default": null,
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "cutId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "answerKey": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": [
                    "cutId",
                    "answerKey"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "eventId"
          ],
          "additionalProperties": false
        }
      },
      "distributions": {
        "default": [],
        "maxItems": 32,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "situationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "probabilities": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "confidence": {
              "default": null,
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "suppliedBy": {
              "default": null,
              "description": "Who holds this distribution, such as the modeler; it is recorded as theirs, not as estimator output.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "situationId",
            "probabilities"
          ],
          "additionalProperties": false
        }
      },
      "idPrefix": {
        "default": "cut.estimated",
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "proposalId": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          {
            "type": "null"
          }
        ]
      },
      "apply": {
        "default": false,
        "type": "boolean"
      },
      "requestId": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          {
            "type": "null"
          }
        ]
      },
      "revisionReason": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          {
            "type": "null"
          }
        ]
      },
      "replaceExisting": {
        "default": false,
        "type": "boolean"
      },
      "rebind": {
        "default": null,
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "graphHash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              },
              "accessScopes": {
                "default": [],
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "requestId": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "graphHash"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "question",
      "answers"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  }
}
