                    },
                    "presses": {
                      "type": "string",
                      "minLength": 10,
                      "maxLength": 2000,
                      "description": "How a story can press it."
                    },
                    "learns": {
                      "type": "string",
                      "minLength": 10,
                      "maxLength": 2000,
                      "description": "What the reader could learn about their own life."
                    },
                    "readerRecords": {
                      "default": [],
                      "description": "The modeled reader's records it presses (cut:, event:, process:); required when a reader is modeled.",
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 1024,
                        "description": "A model record as kind:id (event:ev.x, process:p.x, cut:c.x, referent:r.x, concept:c.x) or a graph node id."
                      }
                    }
